# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env

# Neon Postgres connection string (Project → Dashboard → Connection string)
DATABASE_URL=your_neon_connection_string_here

# Secret used to sign JWTs — any long random string (keep it private)
JWT_SECRET=any_long_random_string

# Port the API listens on (optional, defaults to 3001)
PORT=3001
